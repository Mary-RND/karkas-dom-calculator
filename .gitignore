# В публичный репозиторий входит только приложение-калькулятор
# и обезличенный пример прайса.

# --- отчёты, рабочая тетрадь и материалы ДЗ ---
/Отчёт_*
/Рабочая_тетрадь_*
/*.zip
/*.pdf
/README.txt

# --- оригинал прайса и данные с реальными ценами ---
/original/
/spravochnik_stoimosti_karkasnogo_doma_2026.xlsx
/project/Данные/*рабочий*.xlsx
/project/Данные/*онлайн*.xlsx
/project/Данные/*вручную*.xlsx

# --- готовая сборка для передачи клиенту ---
/Отдать_клиенту/
/project/build/
/project/dist/
/project/__pycache__/
/*.spec

# --- скриншоты (содержат реальные цены) ---
/project/Скриншоты/

# --- служебные скрипты подготовки и диагностика ---
/_служебные/

# --- временные файлы Office ---
~$*
.~lock.*#
