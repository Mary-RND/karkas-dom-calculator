@echo off
chcp 65001 >nul
title Калькулятор стоимости каркасного дома
cd /d "%~dp0"
echo ============================================================
echo   Калькулятор стоимости каркасного дома
echo   Локальное приложение для строительной компании
echo ============================================================
echo.
where python >nul 2>nul
if errorlevel 1 (
